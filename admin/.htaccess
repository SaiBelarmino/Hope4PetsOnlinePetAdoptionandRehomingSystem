# Restrict access to this /admin folder to a single IP and optionally enable Basic Auth.
# Apache 2.4+ compatible. For XAMPP on Windows.

# --- Configuration summary --------------------------------------------------
# - Allow access only from IP 169.254.17.76
# - Any other client will be redirected (HTTP 302) to the site root /index.php
# - Optional Basic Auth snippet is included and commented out. To enable, remove
#   the surrounding comment markers and create an appropriate .htpasswd file.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the remote IP is NOT the allowed one, redirect to site root index.php
    # Using a RewriteCond to compare the REMOTE_ADDR. This issues an external
    # redirect so the browser will be sent to the main site index.
    RewriteCond %{REMOTE_ADDR} !=169.254.17.76
    RewriteRule ^.*$ /index.php [R=302,L]

    # Note: If you prefer an internal rewrite (hide the redirect), replace the
    # RewriteRule above with: RewriteRule ^.*$ /index.php [L]
    # But that will serve index.php content while keeping /admin URL in browser.
</IfModule>

# Fallback - if mod_rewrite is not available, use Require and ErrorDocument
<IfModule !mod_rewrite.c>
    # Deny by default, allow only the single IP.
    <RequireAll>
        Require ip 169.254.17.76
    </RequireAll>

    # Send a 302 redirect to /index.php for denied requests using ErrorDocument.
    # Apache will still send a 403 status, but the ErrorDocument can perform a redirect.
    # Create a tiny redirecting PHP or HTML file if you need exact behavior; for
    # simplicity we instruct Apache to use a relative redirect page.
    ErrorDocument 403 /index.php
</IfModule>

# --- Optional Basic Authentication (commented) -------------------------------
# To enable Basic Auth: 1) create .htpasswd (use htpasswd.exe bundled with XAMPP),
# 2) update the path to .htpasswd below if necessary, 3) uncomment this section.
#
# AuthType Basic
# AuthName "Restricted Admin Area"
# # Windows path example: adjust to your actual path
# AuthUserFile "C:/xampp/htdocs/Hope4PetsOnlinePetAdoptionandRehomingSystem/admin/.htpasswd"
# Require valid-user
#
# If you want both IP restriction AND Basic auth active at the same time,
# combine them with a <RequireAny> / <RequireAll> block (example below):
#
# <IfModule mod_authz_core.c>
#     <RequireAll>
#         Require ip 169.254.17.76
#         Require valid-user
#     </RequireAll>
# </IfModule>

# Recommended header for crawlers
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# End of file
